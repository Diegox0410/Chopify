# Configure ONLY as server-side Vercel environment variables. Never use VITE_ prefixes.
# REQUIRED in production: Firebase, Commerce token, Operations token, tenant allowlist.
# REQUIRED only for WhatsApp live: META_* credentials, FLOES phone id, dispatch secret.
# OPTIONAL: Graph version, state collection, GanoBot URL/token, per-tenant Owner access.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
FLOES_WHATSAPP_PHONE_NUMBER_ID=1294544567080136
FLOES_WHATSAPP_BUSINESS_ACCOUNT_ID=
# JSON-stringified Google service-account object; never commit a populated value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Exact Firebase Storage bucket ID (for example, project-id.firebasestorage.app).
# Used only when CATALOG_IMAGE_STORAGE_PROVIDER=firebase; not required for the FLOES pilot.
CHOPIFY_CATALOG_STORAGE_BUCKET=
CATALOG_IMAGE_STORAGE_PROVIDER=public
# Origin of the FLOES Commerce deployment serving /catalogo/floes/** (Preview URL in Preview).
FLOES_PUBLIC_BASE_URL=
# Local-only input for `npm run sync:floes-public-images`; points at the FLOES Commerce checkout.
FLOES_COMMERCE_REPO_DIR=
CHOPIFY_DISPATCH_SECRET=
# Optional. Until a REAL authenticated backend is available, replies are human-handoff acknowledgments.
GANOBOT_LIVE_URL=
GANOBOT_LIVE_BEARER_TOKEN=

# GanoBot Commerce server-to-server (H3)
CHOPIFY_COMMERCE_API_TOKEN=
CHOPIFY_OPERATIONS_API_TOKEN=
CHOPIFY_COMMERCE_ALLOWED_TENANTS=tenant-floes,tenant-mg,tenant-dgng

# Optional Owner Admin access. Configure only for tenants whose owner workflow is enabled.
CHOPIFY_OWNER_API_TOKEN_FLOES=
CHOPIFY_OWNER_API_TOKEN_MG=
CHOPIFY_OWNER_API_TOKEN_DGNG=

# H11 durable Commerce runtime
CHOPIFY_COMMERCE_STATE_COLLECTION=chopifyCommerceRuntime
