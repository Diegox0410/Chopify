{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/channel-outbox-worker",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|src(?:/|$)|@vite(?:/|$)|@react-refresh$|node_modules(?:/|$)|__vite_ping$).*)",
      "destination": "/index.html"
    }
  ]
}
