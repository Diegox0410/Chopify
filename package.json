{
  "name": "chopify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && node --test tests/*.test.mjs",
    "sync:floes-public-images": "node --import tsx scripts/sync-floes-public-images.ts",
    "pilot:floes:dry-run": "node --import tsx scripts/dry-run-floes-public-catalog.ts",
    "pilot:floes:import-preview": "node --env-file=.env.local --import tsx scripts/import-floes-preview.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "sharp": "^0.35.5",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
